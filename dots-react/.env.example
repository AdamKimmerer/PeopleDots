# Copy to dots-react/.env and fill in. Never commit the real .env.
# Cloudinary account that holds the photo library shown in the "Pick a photo" step.
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: port for the Express server (the React dev server proxies to it).
PORT=5000
